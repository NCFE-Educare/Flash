[Unit]
Description=EduCare Bots FastAPI Application
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/educare
Environment="PATH=/opt/educare/.venv/bin"
ExecStart=/opt/educare/.venv/bin/python run.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
